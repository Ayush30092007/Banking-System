{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore --project banking-system-e346a",
    "serve:functions": "firebase emulators:start --only functions --project banking-system-e346a",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions,firestore --project banking-system-e346a",
    "deploy:functions": "firebase deploy --only functions --project banking-system-e346a",
    "deploy:firestore": "firebase deploy --only firestore --project banking-system-e346a",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
