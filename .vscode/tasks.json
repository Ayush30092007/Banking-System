{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Banking System",
            "type": "shell",
            "command": "g++",
            "args": ["-std=c++17", "-Wall", "-Wextra", "-Iinclude", "main.cpp", "src/*.cpp", "-o", "bank"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
